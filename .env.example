# Copy this file to .env and fill in your values. .env is gitignored.

# Claude API key from https://platform.claude.com (Settings > API keys).
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Spend cap per run in US dollars (one process: an eval run, a smoke test, an
# app session). Calls that could push the run past it are refused. Default 5.
BUDGET_USD=5

# Optional: model for agent runs. Defaults to claude-haiku-5-5 (development).
# Use claude-sonnet-5-5 for final evaluation runs.
# LLM_MODEL=claude-sonnet-5-5
