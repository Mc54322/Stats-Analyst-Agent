# Data: raw downloads and clean outputs stay local.
# `data/*` (not `data/`) so the ingest scripts can be re-included below;
# git cannot re-include files inside a directory that is itself ignored.
data/*
!data/ingest/

# R
.Rhistory
.RData
.Rproj.user/
# renv writes its own renv/.gitignore for the package library

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Environment / secrets
.env
.env.*
!.env.example

# Jupyter
.ipynb_checkpoints/

# Testing / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Outputs
outputs/
*.log

# Editors / OS
.vscode/
.idea/
.DS_Store
